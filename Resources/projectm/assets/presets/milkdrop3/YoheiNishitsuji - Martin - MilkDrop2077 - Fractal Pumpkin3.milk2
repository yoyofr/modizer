warp_1=`//Shader from Yohei Nishitsuji
warp_2=`//https://x.com/YoheiNishitsuji/status/1949255489864581135
warp_3=`//Ported to MilkDrop by MilkDrop2077
warp_4=`
warp_5=`// Helper: 2D rotation matrix
warp_6=`float2x2 rotate2D(float angle) {
warp_7=`    float s = sin(angle);
warp_8=`    float c = cos(angle);
warp_9=`    return float2x2(c, -s, s, c);
warp_10=`}
warp_11=`
warp_12=`// Helper: HSV to RGB
warp_13=`float3 hsv(float h, float s, float v) {
warp_14=`    float3 k = float3(1.0, 2.0/3.0, 1.0/3.0);
warp_15=`    float3 p = abs(frac(h + k) * 6.0 - 3.0);
warp_16=`    return v * lerp(float3(1,1,1), saturate(p - 1.0), s);
warp_17=`}
warp_18=`
warp_19=`// Helper: mod (like GLSL)
warp_20=`float mod(float a, float b) {
warp_21=`    return a - b * floor(a / b);
warp_22=`}
warp_23=`
warp_24=`shader_body
warp_25=`{
warp_26=`    uv = (uv_orig * aspect.xy - 0.5 * aspect.xy) / aspect.y;
warp_27=`    float t = time / 3.0;
warp_28=`    float3 col = float3(0.0, 0.0,0.0);
warp_29=`    float g = 0.0;
warp_30=`
warp_31=`    for (float i = 0.0; i < 80.0; i++) {
warp_32=`        float3 p = float3(uv * 1.5 * (cos(t * 0.3+q10) * 0.2 + 0.6), g - 0.4);
warp_33=`        p.xz = mul(rotate2D(t * 0.5), p.xz);
warp_34=`        float s = 1.0;
warp_35=`        float e = 0.0;
warp_36=`
warp_37=`        for (int j = 0; j < 12; j++) {
warp_38=`            e = max(1.01, 5.0 / dot(p, p));
warp_39=`            p = abs(abs(p) * e - float3(4.6+q1/6, 2.0+q1/5, 1.2+q1/3));
warp_40=`            p = float3(3.5, 5.0, 0.5) - p;
warp_41=`            s *= e;
warp_42=`        }
warp_43=`
warp_44=`        g += mod(length(p.zx), p.y) / s;
warp_45=`        float final_s = log2(s) / g;
warp_46=`        col += hsv(e, p.z, final_s / 1e4);
warp_47=`    }
warp_48=`
warp_49=`    ret = float4(sqrt(col), 1.0);
warp_50=`}
comp_1=`#define sat saturate
comp_2=`float glow, tmp, lamp, dist, bdist, b2dist, dist_c, smask;
comp_3=`float2 dz, uv1, uv3, uv4;
comp_4=`static const float3 CamPos = float3(q4,q5,q6);
comp_5=`static const float myzoom = q7,  res = 255, res2 = 64, tele = q16;
comp_6=`static const float3x3 RotMat = float3x3(q20,q21,q22,q23,q24,q25,q26,q27,q28);
comp_7=`
comp_8=`float2 fstep2 (float2 xy) {return 1.0/res*round(res*xy);}
comp_9=`
comp_10=`float GetDist(float2 uvi) {float2 tmp; tmp = (tex2D (sampler_fc_main, uvi).gb); 
comp_11=`return 1.0078125-tmp.y -0.015625*tmp.x;} // = 1-(tmp.y + 1.0/res2*(tmp.x-.10));}
comp_12=`
comp_13=`float GetDistB(float2 uvi)  {return 1-GetBlur1(uvi).b;}
comp_14=`float3 screen3;
comp_15=`float3 lavcol (float t) {return saturate(float3(pow(t,1),pow(t,2.),pow(t,5)));}
comp_16=`
comp_17=`static float3 t = float3(3,3,3);
comp_18=`static float3 s = float3(1,1,1);
comp_19=`static float3 ts = -cross(s,t);
comp_20=`static float3 pos = float3 (1,1,1);
comp_21=`
comp_22=`float3 project (float dist) {  float z;
comp_23=`  z = 18*dist/mul(cross(ts,-t),screen3);
comp_24=`  return float3(mul(float2x3(ts,t),cross(pos,screen3))-z,-z);}
comp_25=`
comp_26=`shader_body {//MilkDrop3 Flip Mode:
comp_27=`uv = 1-uv;
comp_28=`//MilkDrop3 Split Mode:
comp_29=`uv = float2 (abs(uv.x-0.5), uv.y);
comp_30=`
comp_31=`screen3 = float3 ((uv-.95)*aspect.xy,tele-0+1);
comp_32=`float3 uv2 = project(.1);
comp_33=`float3 sky = sat(lavcol (1-(abs(22/uv2.z))))-.2;
comp_34=`
comp_35=`bdist = min(GetDist(uv),GetDistB(uv));;
comp_36=`
comp_37=`sky *= sat(3*bdist-2);
comp_38=`ret = sat(lerp (0, sky, bdist));
comp_39=`
comp_40=`float struc = lerp(GetPixel(uv).r, GetBlur1((uv-.5)/5+.5).r,GetBlur1(uv).r-.8);
comp_41=`ret += lavcol(struc)*(2-pow(bdist,1+180*mid_att));
comp_42=`//ret = struc;
comp_43=`//MilkDrop3 Color Mode:
comp_44=`ret /= float3(1.5,1.9,0.9);
comp_45=`}
