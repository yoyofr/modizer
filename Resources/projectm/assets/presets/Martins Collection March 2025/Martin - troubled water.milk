shape_3_per_frame19=
shape_3_per_frame20=//if (reg15&&(i+1<4*bass_att), a=1; r=b=0.5;,0);
per_frame_init_1=n=0; loop (5000, megabuf(n)=0; gmegabuf(n)=0.4+rand(1)*.2; n +=1; );
per_frame_init_2=pi = 3.1416;
per_frame_init_3=sanz=10;
per_frame_1=dt = min (1/fps,0.1) ;
per_frame_2=dec_m = 1-4*dt; dec_s = 1-dt;
per_frame_3=vol =  (2*bass+mid+treb)/4; 
per_frame_4=vol_ = vol_*dec_m + (1-dec_m)*vol; 
per_frame_5=vol1 = vol1*0.5 + 0.5*vol;
per_frame_6=bt=(vol>pk)&&(time>t0+0.1);
per_frame_7=if(bt,t0=time;pk=vol*3;rmp=1,0);
per_frame_8=pk*=dec_m; idx+=bt; idx2+=bt*(idx%4==0);
per_frame_9=rmp=max(0,rmp-dt*1);
per_frame_10=
per_frame_11=q21 = max(0.4,min(1.7,vol_-0.2))*0.8;
per_frame_12=q24 = bt;
per_frame_13=n=300; loop(100,gmegabuf(n+1)=gmegabuf(n); n-=1); gmegabuf(201)=pow(vol,0.75);
per_frame_14=q25 = exp(-vol1*0.7)*0.75;
per_frame_15=q10 = pk;
per_frame_16=if(pk>2.5,
per_frame_17=  r2=int (rand(sanz));
per_frame_18=  gmegabuf(r2*2)=  0.5+ (rand(1)-0.5)*0.85*min(1,vol/2);
per_frame_19=  gmegabuf(r2*2+1)=0.5+ (rand(1)-0.5)*0.85*min(1,vol/2);,0);
per_frame_20=
per_frame_21=BPM=137;
per_frame_22=fg = BPM/60/2; Q=2.8; omega = 6.283*min(0.5,fg/fps); tcos = cos (omega); alpha = sin(omega)/(2*Q);
per_frame_23=b0=(1-tcos)/2; b1=1-tcos; b2=(1-tcos)/2; a0=1+alpha; a1=-2*tcos; a2=1-alpha;
per_frame_24=b0a0=b0/a0; b1a0=b1/a0; b2a0=b2/a0; a1a0=a1/a0; a2a0=a2/a0;
per_frame_25=
per_frame_26=//Basis sollpos: 0; ist: 100
per_frame_27=n=0;
per_frame_28=loop (sanz,
per_frame_29=  s = 0;
per_frame_30=  mx = 1000+n*10;
per_frame_31=  loop (2, //x und y
per_frame_32=   gmegabuf(mx)   = gmegabuf(2*n+s);   //xa
per_frame_33=   gmegabuf(mx+1) = b0a0*gmegabuf(mx)  + b1a0*gmegabuf(mx+2) + b2a0*gmegabuf(mx+3) - a1a0*gmegabuf(mx+4) - a2a0*gmegabuf(mx+5); 
per_frame_34=   gmegabuf(mx+3)= gmegabuf(mx+2);    gmegabuf(mx+2)= gmegabuf(mx);   gmegabuf(mx+5)= gmegabuf(mx+4);
per_frame_35=   gmegabuf(mx+4)= gmegabuf(mx+1);    gmegabuf(mx)= gmegabuf(mx+1);
per_frame_36=   mx += 1000;
per_frame_37=   s+=1;);
per_frame_38=n+=1;
per_frame_39=);
per_frame_40=
per_frame_41=tr1 = time*0.13;
per_frame_42=if (sin(tr1)<0, r1x=rand(1); r1y=rand(1);, 0);
per_frame_43=if (cos(tr1)<0, r2x=rand(1); r2y=rand(1);, 0);
per_frame_44=q1=r1x; q2=r1y; q3 = max(0,sin(tr1))*0.8; q4=tr1/3.3;
per_frame_45=q5=r2x; q6=r2y; q7 = max(0,cos(tr1))*0.8; q8=-tr1/7.2;
per_frame_46=
per_frame_47=reg10+=(idx%16==0)*dt*0.8;
per_frame_48=lv=(vol_<0.5+lv*0.4);
per_frame_49=reg11=!lv;
per_frame_50=reg12=idx;
per_frame_51=reg13=rmp*sanz;
per_frame_52=reg32=aspecty;
per_frame_53=reg14+=vol_*dt/2;
per_frame_54=reg15=(idx2/4)%4==0;
per_frame_55=
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`float buf2;
warp_3=`float2 uv1;
warp_4=`static const float2 pix = texsize.zw*2.4;
warp_5=`
warp_6=`float3 GetBuf(float2 uvi)
warp_7=`{float3 res;  res = GetPixel(uvi)-.5;  return pow(res,2)*sign(res);}
warp_8=`
warp_9=`shader_body {
warp_10=`uv = uv_orig;
warp_11=`uv1 = uv;;;
warp_12=`buf2 = (GetBuf(uv1+pix*float2(1,0)).y + GetBuf(uv1+pix*float2(0,1)).y
warp_13=`       +GetBuf(uv1+pix*float2(-1,0)).y+ GetBuf(uv1+pix*float2(0,-1)).y
warp_14=`       +GetBuf(uv1+pix*float2(2,0)).y/2  +GetBuf(uv1+pix*float2(0,2)).y/2
warp_15=`       +GetBuf(uv1+pix*float2(-2,0)).y/2 +GetBuf(uv1+pix*float2(0,-2)).y/2)/3 
warp_16=`       - GetBuf(uv1).x;
warp_17=`
warp_18=`buf2 = buf2*0.975+0.15*(rand_preset.x>0.3)*GetBlur1(uv).b;;
warp_19=`ret = float3 (tex2D (sampler_pw_main,uv).y, sign(buf2)*sqrt(abs(buf2))+.5,0);
warp_20=`ret.b += GetPixel(uv).b*q25*(1-GetBlur2(uv).b/2); 
warp_21=`//ret.b = max(ret.b,GetPixel(float2(1-uv.x,uv.y)).b/3); 
warp_22=`
warp_23=`}
warp_24=`
warp_25=`
comp_1=`#define sat saturate
comp_2=`sampler sampler_rand00;
comp_3=`sampler sampler_clouds;
comp_4=`float3 bcol;
comp_5=`float2 uv0,uv1,uv2,dz;
comp_6=`float bri, shine,radi,bmask;
comp_7=`static const float anz=18;
comp_8=`static float2 hor = float2(1,0)*texsize.zw;
comp_9=`static float2 ver = float2(0,1)*texsize.zw;
comp_10=`#define GB1 GetBlur1
comp_11=`#define GB2 GetBlur2
comp_12=`#define GB3 GetBlur3
comp_13=`#define GP GetPixel
comp_14=`
comp_15=`shader_body
comp_16=`{
comp_17=`dz.x = GB1(uv+hor*4).r-GB1(uv-hor*4).r;
comp_18=`dz.y = GB1(uv+ver*4).r-GB1(uv-ver*4).r;
comp_19=`
comp_20=`bcol = tex2D (sampler_noise_hq,uv*.03+time*0.008)+.6;
comp_21=`ret = tex2D(sampler_clouds,uv-dz*2)/5 ;
comp_22=`
comp_23=`bmask = sat(GP(uv).b*6);
comp_24=`ret = lerp(ret, (ret+GB1(uv+dz*0.25).b)*6, bmask)*bcol;
comp_25=`ret +=  GB3(uv-dz*1).b*10*bcol; //???
comp_26=`
comp_27=`shine = 0; radi = 0.95;
comp_28=`for (int n=1; n <= anz; n++)
comp_29=`{ shine += 1/anz*GB2((uv-.5)*radi+.5).b;
comp_30=`  radi -= 0.95/anz;}
comp_31=`ret += 4*shine * bcol;
comp_32=`
comp_33=`uv2 = float2(1/rad+time*0,ang)*.2;
comp_34=`ret += tex2D(sampler_rand00,uv+dz)*.4*rad*rad;
comp_35=`ret *= 1-0.3*(lum(GP(uv))<0.05);
comp_36=`
comp_37=`//etwas Glitzer
comp_38=`ret += sat(1-lum(ret))*GetBlur1(uv+dz).b*6*min(2,treb_att/2)*bcol;
comp_39=`}
comp_40=`//martin
