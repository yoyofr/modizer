per_frame_init_1=reg03 = 4; //early brightness
per_frame_init_2=maxage=12;  reg20=1/maxage;
per_frame_init_3=reg30 =.25 + 0.6*rand(1); //z0
per_frame_init_4=reg04 = 0.5; //wave bri
per_frame_init_5=res = 16;
per_frame_init_6=tini = rand(10);
per_frame_init_7=nums = 512*4; reg18=nums;
per_frame_init_8=mpos=30000; //matrix start
per_frame_init_9=n = 0; loop (nums, 
per_frame_init_10=  arg = rand(12);
per_frame_init_11=  n[0]=.3*cos(arg);
per_frame_init_12=  n[1]=.1*sin(arg*0);
per_frame_init_13=  n[2]= rand(1)-.5;
per_frame_init_14=  n[3]=n[4]=n[5]=n[8]=0;
per_frame_init_15=  n[6]=rand(5)+1;
per_frame_init_16=  n[7]=0;
per_frame_init_17=n +=10; );
per_frame_init_18=
per_frame_init_19=memset(mpos,0,res*res*res);
per_frame_1=dt=1/fps ;
per_frame_2=t0=time*0.0018+tini;
per_frame_3=
per_frame_4=d2=exp(-dt*2);
per_frame_5=d3=exp(-dt*0);
per_frame_6=d4=exp(-dt*4);
per_frame_7=
per_frame_8=if (frame%4==0, n=0; loop(res*res*res, mpos[n]*=d2; n+=1); ,0);
per_frame_9=ff = sqrt(3000/nums)*(cos(t0*14))*(1-d2); 
per_frame_10=
per_frame_11=s1=sin(t0*13)*2;  s2=sin(t0*11)*2;  s3=sin(t0*9)*2;
per_frame_12=s4=sin(t0*23)*7;  s5=sin(t0*29)*5;  s6=sin(t0*31)*7;
per_frame_13=s7=sin(t0*18)*4;  s8=sin(t0*15)*4;  
per_frame_14=reg05=sin(t0*5);
per_frame_15=
per_frame_16=i=0;
per_frame_17=loop (nums+50, //50 shapes
per_frame_18=  if ((i[7]>maxage) || (gmem[i+7]<0),
per_frame_19=    i[2]= (rand(1)-0.5)*reg30;
per_frame_20=    tmp = (i[2]+reg30)/reg30;
per_frame_21=    i[0]=(rand(1)-0.5)/aspectx*tmp;
per_frame_22=    i[1]=(rand(2)-1)*(rand(2)-1)/aspecty*tmp*0.6;
per_frame_23=    i[6]=1-rand(1)*0.3; //ageing factor
per_frame_24=    i[7]=0; //age
per_frame_25=  ,0 );
per_frame_26=
per_frame_27=  x=i[0]; y=i[1]; z=i[2];
per_frame_28=
per_frame_29=  ix=int(res*(.5+x)+.5);
per_frame_30=  iy=int(res*(.5+y)+.5);
per_frame_31=  iz=int(res*(.5+z)+.5);
per_frame_32=  index = max(0,min(res-1,ix))+res*(max(0,min(res-1,iy))+res*max(0,min(res-1,iz)));
per_frame_33=  if ((ix>=0) && (ix<res) && (iy>=0) && (iy<res) && (iz>=0) && (iz<res), 
per_frame_34=    mpos[index] +=1;
per_frame_35=  ,0);
per_frame_36=  
per_frame_37=  dens=i[8]*d4 +  sqrt(mpos[index])*ff*(1-d4);
per_frame_38=   
per_frame_39=  ilen=invsqrt(sqr(x) + sqr(y) + sqr(z)+.004);
per_frame_40=  fx= cos(   x*s4 + y*s5 + z*s6+ ilen*s1)*(1+dens*y*ilen);
per_frame_41=  fy= sin(s7+x*s5 + y*s6 + z*s4+ ilen*s2)*(1+dens*z*ilen);
per_frame_42=  fz= sin(s8+x*s6 + y*s4 + z*s5+ ilen*s3)*(1+dens*x*ilen);
per_frame_43=
per_frame_44=  i[3] = i[3]*d4 +fx*(1-d4)*if(i<10*nums,.06,0.02);
per_frame_45=  i[4] = i[4]*d4 +fy*(1-d4)*if(i<10*nums,.04,0.02);
per_frame_46=  i[5] = i[5]*d4 +fz*(1-d4)*if(i<10*nums,.04,0.02);
per_frame_47=
per_frame_48=  i[0] = x*d3 +i[3]*dt;  
per_frame_49=  i[1] = y*d3 +i[4]*dt;  
per_frame_50=  i[2] = z*d3 +i[5]*dt;
per_frame_51=  i[7] += i[6]*dt;
per_frame_52=  i[8] = dens;
per_frame_53=
per_frame_54=  gmem[i]   =i[0];    
per_frame_55=  gmem[i+1] =i[1];    
per_frame_56=  gmem[i+2] =i[2];
per_frame_57=  gmem[i+7] =i[7];
per_frame_58=i+=10);
