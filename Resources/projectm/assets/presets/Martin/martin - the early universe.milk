warp_1=`sampler sampler_pw_noise_lq;shader_body {
warp_2=`float3 noise = tex2D(sampler_pw_noise_lq,uv_orig*1+rand_frame);
warp_3=`ret = max(GetPixel(uv)*.72,GetBlur1(uv));
warp_4=`ret = ret*0.98-0.01*lum(GetBlur1(uv))-0.0025*saturate(2*noise.x-1);
warp_5=`
warp_6=`//ret = 0;
warp_7=`}
comp_1=`static const float2 pix = texsize.zw;
comp_2=`float3 get(float2 uvi)
comp_3=`{float3 t = GetPixel(uvi);
comp_4=`        t= max(t,max(GetPixel(uvi+pix*float2(-1,1))/2,GetPixel(uvi-pix*float2(-1,1))/2));
comp_5=`        t= max(t,max(GetPixel(uvi+pix*float2(1,1))/2,GetPixel(uvi-pix*float2(1,1))/2));
comp_6=`return t;}
comp_7=`
comp_8=`shader_body
comp_9=`{
comp_10=`uv = uv_orig;
comp_11=`ret = GetPixel(uv)+GetBlur3(uv)*0.8;
comp_12=`float3 ret2 = GetBlur3((uv-.5)*.85+.5);
comp_13=`ret += lerp(ret2,lum(ret2),.4)*.4;
comp_14=`
comp_15=`float3 hl = saturate(GetPixel(uv)-GetBlur1(uv));
comp_16=`//ret += hl*(rand_preset.x-.5)*1;
comp_17=`ret*=1.2;
comp_18=`//ret =1-exp(-1.3*ret);
comp_19=`//ret = sqrt(ret);
comp_20=`}
